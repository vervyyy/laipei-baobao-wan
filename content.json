  "principles": {
    "beliefs": [
      "专注力最重要——他专心的时候，不打断、不提问、不纠正",
      "生活里现成的场景，比专门买的教具更好用",
      "邀请他参与真实生活：一起扫地、叠衣服、递东西——不是全家围着他玩，是让他加入我们本来在做的事",
      "家里的勺子、筷子、夹子，就够他玩很久、练很久",
      "个体差异比书上的月龄表重要得多",
      "跟着他的兴趣走：他最近迷什么就给什么（我们家现在是鱼，就找鱼的书）",
      "不替他做决定：他想玩手上那个、想穿那双我觉得丑的鞋——那是他的人生",
      "让他自己来，掌控感和自信是这么长出来的",
      "允许晃荡：去公园不用把项目玩完，路上他已经在看、在学了",
      "爸妈也是人：会崩溃、会做错。跟他认错、允许自己有情绪，比硬忍着好——他能感觉到你在忍"
    ],
    "avoid": [
      "不打断他正在做的事",
      "不一直纠正他",
      "不给每件事都安排\"这是在培养什么\"——单纯地玩，本身就够了",
      "不设计超出他现在能力的玩法，他会挫败",
      "不要求他必须玩我们准备的那个"
    ]
  },
  "scripts": [
    {
      "scenario": "宝宝打/推同伴",
      "script": "蹲下来看着宝宝，平静地说：\"手是用来抱抱的，不是用来打人的。\"再帮 ta 说出情绪：\"你是不是有点生气？\"不用急着逼道歉。"
    },
    {
      "scenario": "宝宝抢玩具/不愿分享",
      "script": "不用强迫分享，可以说：\"这是你现在在玩的，玩具轮流玩，我们等一下再借给他/她。\"先尊重物权意识。"
    },
    {
      "scenario": "宝宝情绪崩溃、大哭大闹",
      "script": "先蹲下靠近或抱住宝宝：\"我看到你很难过/很生气。\"先接住情绪，不急着讲道理或制止。"
    },
    {
      "scenario": "宝宝害怕、紧张（怕打针、怕生）",
      "script": "不说\"不要怕\"，而是说：\"这个确实有点吓人，妈妈/爸爸在这里陪着你。\""
    },
    {
      "scenario": "宝宝不配合（穿衣服/洗澡/出门）",
      "script": "给有限选择代替命令：\"你想先穿袜子还是先穿裤子？\"让宝宝有掌控感。"
    },
    {
      "scenario": "宝宝摔倒/磕碰",
      "script": "先观察伤势，不夸张反应，平静地问：\"摔到哪里了？疼不疼？\"避免过度紧张吓到宝宝。"
    },
    {
      "scenario": "自己快要爆炸了",
      "script": "先说出来：\"妈妈现在有点累，需要坐一下。\"走开一分钟不算失职。事后可以跟他说：\"刚才妈妈声音大了，对不起。\"认错不会掉价。"
    },
    {
      "scenario": "他在专心玩，你很想夸他/教他",
      "script": "先忍住。等他抬头看你、或者玩完了，再说。打断一次专注，比少夸一句可惜多了。"
    }
  ],
  "safetyChecklist": [
    "插座都装了安全盖",
    "桌角/柜角包了防撞角",
    "小件物品/纽扣电池收在宝宝够不到的地方",
    "窗帘绳/电线收好，不垂在宝宝能拉到的地方",
    "家具固定好，不会被拉倒",
    "药品/清洁剂锁在高处或带锁柜子里"
  ],
  "safetyReminders": [
    "洗澡/戏水时一秒都不能离开视线，去开个门也要抱着走",
    "车里前后座都看一眼再锁车，别把孩子忘车上",
    "纽扣电池、磁力珠这类小物件，吞了要立刻去医院，不能等",
    "睡觉仰卧、床上不放毛绒玩具/软枕头/护栏垫",
    "坐车必须用安全座椅，2岁以下尽量反向安装",
    "药品、清洁剂锁起来，不要觉得\"就一下下没关系\""
  ],
  "firstAidCards": [
    {
      "title": "异物卡住 / 窒息（1岁以下）",
      "steps": [
        "让宝宝俯卧在你前臂上，头略低于身体，用你的大腿撑住手臂",
        "用掌根在两肩胛骨中间用力拍背，连续5次",
        "没出来就把宝宝翻成面朝上，两根手指在胸骨中央下压，连续5次（比CPR力度轻）",
        "拍背和压胸交替进行，直到异物出来或宝宝有反应变化",
        "看不到异物不要用手指去抠，可能把它推得更深",
        "宝宝失去反应，立刻拨打急救电话，同时开始婴儿CPR（如果学过）"
      ],
      "warn": "1岁以下禁止用腹部冲击（海姆立克），可能伤到内脏"
    },
    {
      "title": "异物卡住 / 窒息（1岁以上）",
      "steps": [
        "站或跪在孩子身后，一手扶住胸口，让孩子身体前倾、头低于胸口",
        "用掌根在两肩胛骨中间用力拍背，连续5次",
        "没出来就从背后环抱腰部，拳头放在肚脐上方，用力向内向上冲击，连续5次",
        "拍背和腹部冲击交替进行，直到异物出来或孩子失去反应",
        "失去反应立刻拨打急救电话并开始CPR"
      ],
      "warn": "冲击力度按孩子体型调整，别用对付大人的力气"
    },
    {
      "title": "烫伤",
      "steps": [
        "立刻用凉的流动自来水冲洗烫伤处，冲够20分钟",
        "冲的过程中脱掉覆盖伤口的衣物（除非黏在皮肤上，黏住的部分别硬扯）",
        "冲完可以用干净纱布松松盖住，不要用棉花直接贴",
        "不要涂牙膏、酱油、香油或任何偏方，也不要弄破水泡"
      ],
      "warn": "烫伤面积比孩子手掌大、起水泡、或长在脸/手/关节/生殖器部位——冲完水立刻去医院"
    },
    {
      "title": "摔倒 / 头部撞击",
      "steps": [
        "先冷静观察，不要立刻抱起来剧烈摇晃安抚",
        "有伤口先用干净纱布压迫止血，持续按压10分钟",
        "接下来24小时密切观察，即使睡着了也要能被正常叫醒",
        "拿不准严重程度时，宁可去医院看一下"
      ],
      "warn": "出现意识丧失、抽搐、反复呕吐、异常嗜睡叫不醒、走路说话不对劲，或婴儿囟门凸出——立刻打急救电话"
    },
    {
      "title": "发烧",
      "steps": [
        "3个月以上：精神状态好、能吃能玩，可以先在家观察，多喝水/奶，穿薄一点物理降温",
        "记录体温和时间，方便告诉医生变化趋势",
        "精神差、持续哭闹哄不好、体温持续不退、伴随皮疹——尽快就医"
      ],
      "warn": "3个月以下宝宝只要体温超过38°C，直接去医院，不要在家等着观察"
    },
    {
      "title": "严重过敏反应",
      "steps": [
        "轻度（局部红疹、痒）：先脱离过敏源，咨询医生要不要用抗过敏药",
        "如果有医生开的肾上腺素笔，严重反应时立刻使用",
        "使用后仍需立刻送医，肾上腺素效果是暂时的"
      ],
      "warn": "嘴唇/舌头/脸肿胀、呼吸困难、全身荨麻疹——这是过敏性休克征兆，立刻拨打急救电话"
    },
    {
      "title": "割伤 / 流血",
      "steps": [
        "用干净纱布或毛巾直接按压伤口，持续5-10分钟，中途别掀开看",
        "抬高受伤的部位，帮助减少出血",
        "血止住后清洗伤口、涂抹药膏、纱布覆盖",
        "有异物插在伤口里，不要拔出来，固定住直接送医"
      ],
      "warn": "血流不止、伤口很深、或喷射状出血——立刻去医院"
    }
  ],
  "lessonRitual": {
    "open": {
      "text": "开场：抱一抱，唱同一首歌",
      "materials": "不用道具",
      "steps": [
        "每次都用同一首歌开场（Twinkle Twinkle 或者你自己编一句都行）",
        "唱完说一句\"我们今天玩XX\"，把主题说出来",
        "固定的开场是让他知道\"要开始了\"，别每次换"
      ]
    },
    "close": {
      "text": "收尾：一起收好，说再见",
      "materials": "不用道具",
      "steps": [
        "把今天用到的东西一起放回去，你收一半他收一半",
        "唱同一首结束歌，或者固定说一句\"今天玩完啦\"",
        "抱一下就结束，不用总结、不用考他"
      ]
    }
