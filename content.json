  "modules": [
    {
      "id": "gross",
      "name": "大运动",
      "icon": "run",
      "color": "sky",
      "activities": [
        {
          "text": "趴着抬头看玩具",
          "stage": "s1",
          "materials": "颜色鲜明的玩具或你的脸",
          "steps": [
            "清醒的时候让他趴一小会儿",
            "在他正前方晃玩具，或者你自己趴下来跟他对视",
            "哼唧了就抱起来，一次几十秒就够"
          ]
        },
        {
          "text": "侧躺推一把学翻身",
          "stage": "s2",
          "materials": "爬行垫或床",
          "steps": [
            "让他侧躺，把玩具放在他背后一点点的位置",
            "轻轻托一下他的髋部，剩下的让他自己使劲",
            "翻过去卡住了就帮一把，不用反复练"
          ]
        },
        {
          "text": "坐着够旁边的东西",
          "stage": "s3",
          "materials": "几件轻的玩具",
          "steps": [
            "让他坐稳，把玩具放在伸手刚好够得着的侧前方",
            "让他自己转身去拿，练躯干稳定",
            "身后垫个枕头，倒了也不疼"
          ]
        },
        {
          "text": "钻纸箱隧道",
          "stage": "s4",
          "materials": "去掉两头盖子的纸箱，或两把椅子搭条毯子",
          "steps": [
            "隧道两头各放一个他喜欢的东西",
            "你先示范爬一次给他看",
            "让他自己来回钻，别催速度"
          ]
        },
        {
          "text": "追着球爬",
          "stage": "s4",
          "materials": "一个软球",
          "steps": [
            "把球轻轻滚开一小段距离",
            "让他爬过去追",
            "追到了让他自己推一下球，再玩一轮"
          ]
        },
        {
          "text": "学小动物爬",
          "stage": "s4",
          "materials": "爬行垫",
          "steps": [
            "你先做给他看：熊爬（手脚撑地屁股翘）、青蛙蹲跳",
            "他跟不跟随都行，看你做也是学",
            "在垫子上做，别在硬地板"
          ],
          "themes": [
            "animal"
          ]
        },
        {
          "text": "扶着沙发站起来蹲下去",
          "stage": "s5",
          "materials": "矮沙发或茶几",
          "steps": [
            "把玩具放在沙发面上，让他扶着站起来拿",
            "再放一个到地上，让他蹲下去捡",
            "站起蹲下这个来回就是最好的腿部练习"
          ]
        },
        {
          "text": "扶站够高一点的东西",
          "stage": "s5",
          "materials": "矮柜或茶几、他喜欢的玩具",
          "steps": [
            "把玩具放在比他伸手略高一点的地方",
            "让他扶着踮脚去够",
            "够到就行，不要一次次加高试他极限"
          ]
        },
        {
          "text": "扶着家具横着挪",
          "stage": "s6",
          "materials": "沙发或茶几",
          "steps": [
            "在沙发另一头放个他想要的小东西",
            "让他扶着边缘横着挪过去",
            "在旁边护着就好，别拉他的手带他走"
          ]
        },
        {
          "text": "推纸箱/推车往前走",
          "stage": "s6",
          "materials": "装了点重物的纸箱，或稳的学步推车",
          "steps": [
            "扶他站到箱子后面，手放在箱沿上",
            "轻轻带他往前一小段，然后放手让他自己推",
            "箱子里压点东西，不然会滑太快"
          ]
        },
        {
          "text": "独走几步去拿玩具",
          "stage": "s7",
          "materials": "他最想要的那个玩具",
          "steps": [
            "你蹲在离他两三步的地方，手里拿着玩具",
            "张开手等他走过来，别往后退逗他",
            "摔坐了就说\"没事\"，语气平常一点"
          ]
        },
        {
          "text": "爬枕头山",
          "stage": "s7",
          "materials": "两三个枕头或抱枕",
          "steps": [
            "把枕头堆成小山放在垫子上",
            "让他爬上去、翻过去，或者绕过去都行",
            "摔进枕头堆本身就是好玩的部分"
          ]
        },
        {
          "text": "床上打滚翻跟头",
          "stage": "s7",
          "materials": "床垫或厚爬行垫",
          "steps": [
            "在软的地方让他自由打滚",
            "你也可以躺下跟他一起滚",
            "护住床边，别靠太近"
          ]
        },
        {
          "text": "踢球",
          "stage": "s8",
          "materials": "一个软球",
          "steps": [
            "球放他脚前，你先踢一下给他看",
            "扶着他的手让他试一脚",
            "踢歪了、踩到了都算，别纠正姿势"
          ]
        },
        {
          "text": "抛球进纸箱",
          "stage": "s8",
          "materials": "纸箱或洗衣篮、几个软球",
          "steps": [
            "箱子放在他跟前一点点的地方",
            "示范扔一个进去",
            "进不进都鼓励，他会自己慢慢调整距离"
          ]
        },
        {
          "text": "拿小喷壶浇花",
          "stage": "s8",
          "materials": "小喷壶或小水杯、家里的花",
          "steps": [
            "装少一点水，太重他拿不动",
            "让他自己按/倒，洒出来没关系",
            "浇完可以一起摸摸叶子"
          ],
          "themes": [
            "chores",
            "nature"
          ]
        },
        {
          "text": "推着椅子在屋里走",
          "stage": "s8",
          "materials": "轻的小椅子或纸箱",
          "steps": [
            "清出一条没有障碍的路线",
            "让他推着椅子自己走",
            "地板太滑的话垫块毯子"
          ]
        },
        {
          "text": "蹲下来擦地板",
          "stage": "s8",
          "materials": "他自己的小抹布",
          "steps": [
            "给他一块专属的湿抹布",
            "你在旁边擦你的，他擦他的",
            "擦得干不干净完全不重要"
          ],
          "themes": [
            "chores"
          ]
        },
        {
          "text": "追泡泡",
          "stage": "s9",
          "materials": "儿童泡泡水",
          "steps": [
            "在空地上吹泡泡",
            "让他跑着去追、去拍",
            "他盯着泡泡发呆也别打断，那也是在看"
          ],
          "when": "有泡泡水时"
        },
        {
          "text": "你追我跑",
          "stage": "s9",
          "materials": "一块空地",
          "steps": [
            "说\"我要来抓你啦\"然后慢慢追",
            "让他跑赢，追到就抱起来转一圈",
            "轮流当追的人，他会更投入"
          ],
          "when": "有空地时"
        },
        {
          "text": "抛圈圈套瓶子",
          "stage": "s9",
          "materials": "塑料圈或纸盘挖洞、几个矿泉水瓶",
          "steps": [
            "瓶子摆在他前面一两步",
            "示范套一次",
            "套不中就往前站一点，让他有得手的机会"
          ]
        },
        {
          "text": "跟着音乐跳舞做操",
          "stage": "s9",
          "materials": "随便放首歌，或者你自己哼",
          "steps": [
            "放音乐，你先跳起来",
            "拍手、跺脚、转圈，动作大一点",
            "他跟不上节奏没关系，自己乱动最好"
          ]
        },
        {
          "text": "拎着小桶走一段",
          "stage": "s9",
          "materials": "小桶或小袋子，里面放几样东西",
          "steps": [
            "装轻一点，让他一只手能拎起来",
            "从客厅拎到房间，给他一个\"任务\"",
            "换手拎也是练习"
          ]
        },
        {
          "text": "扶栏杆上下台阶",
          "stage": "s10",
          "materials": "楼梯或两三阶矮台阶",
          "steps": [
            "全程站在他下方一阶护着",
            "上楼让他自己手脚并用",
            "下楼更危险，可以先抱下来"
          ],
          "when": "有台阶时"
        },
        {
          "text": "踩着垫子过河",
          "stage": "s10",
          "materials": "几块坐垫或地垫",
          "steps": [
            "把垫子间隔摆开当\"石头\"",
            "牵着他一块块踩过去",
            "熟了以后放手让他自己踩"
          ]
        },
        {
          "text": "赤脚踩不同材质",
          "stage": "s10",
          "materials": "瑜伽垫、毛毯、草地、鹅卵石垫",
          "steps": [
            "让他光脚依次走过不同的地面",
            "一边走一边说\"软软的\"\"凉凉的\"",
            "他不愿意踩就跳过，别硬拉"
          ],
          "when": "有条件时",
          "themes": [
            "nature"
          ]
        },
        {
          "text": "双脚跳过一条线",
          "stage": "s11",
          "materials": "地上贴条胶带，或放个呼啦圈",
          "steps": [
            "先示范双脚一起跳过去",
            "牵着他的手一起跳几次",
            "他单脚迈过去也算，慢慢来"
          ]
        },
        {
          "text": "从矮台阶往下跳",
          "stage": "s11",
          "materials": "一阶矮台阶或厚垫子",
          "steps": [
            "牵着他两只手站在台阶上",
            "数一二三一起往下跳",
            "落地时扶稳，别让他自己试高的"
          ]
        },
        {
          "text": "单脚站一下",
          "stage": "s12",
          "materials": "一面墙或你的手",
          "steps": [
            "扶着墙，示范抬起一只脚",
            "能站一两秒就很好",
            "可以编成\"小金鸡\"游戏"
          ]
        },
        {
          "text": "自己上下楼梯",
          "stage": "s12",
          "materials": "有扶手的楼梯",
          "steps": [
            "让他扶着栏杆自己一步步走",
            "你在旁边跟着但不扶",
            "累了就抱，不用每次都走完"
          ],
          "when": "有楼梯时"
        },
        {
          "text": "滑步车/三轮车",
          "stage": "s12",
          "materials": "滑步车或三轮车、头盔",
          "steps": [
            "先让他坐上去用脚滑着走",
            "熟悉了再引导蹬踏板",
            "不上路，在小区空地或公园里玩"
          ],
          "when": "出门时"
        }
      ]
    },
    {
      "id": "fine",
      "name": "精细动作",
      "icon": "hand",
      "color": "coral",
      "activities": [
        {
          "text": "抓握摇铃",
          "stage": "f1",
          "materials": "摇铃、软布书、任何好抓的东西",
          "steps": [
            "把摇铃放进他手心，让他自己握住",
            "轻轻晃一下让他听到声音",
            "掉了就再递一次，反复几轮"
          ]
        },
        {
          "text": "捏小块食物",
          "stage": "f2",
          "materials": "香蕉块、煮软的面条、小块馒头",
          "steps": [
            "切成他能一手抓住的小条",
            "放在餐盘上让他自己抓",
            "抓一手糊也没关系，那是必经过程"
          ],
          "when": "吃饭时"
        },
        {
          "text": "捏起小颗粒",
          "stage": "f3",
          "materials": "泡芙、小米花、蒸软的胡萝卜丁",
          "steps": [
            "把几颗放在浅盘子里",
            "让他用拇指和食指捏起来",
            "全程在旁边看着，防噎"
          ]
        },
        {
          "text": "自己抓着吃",
          "stage": "f4",
          "materials": "香蕉块、面包条、蒸软的西兰花",
          "steps": [
            "把食物放在他自己的餐盘上",
            "不喂，让他自己抓自己送嘴里",
            "地上先铺张垫子，收拾起来轻松"
          ],
          "when": "吃饭时"
        },
        {
          "text": "捡树叶石头装小桶",
          "stage": "f4",
          "materials": "小桶或小袋子",
          "steps": [
            "在公园或路边让他自己捡",
            "捡什么由他决定，别帮他挑",
            "回家可以倒出来一起看看"
          ],
          "when": "出门时",
          "themes": [
            "nature"
          ]
        },
        {
          "text": "堆积木",
          "stage": "f5",
          "materials": "2-6块积木",
          "steps": [
            "示范叠两块",
            "让他自己试，倒了就再来",
            "他更想推倒也行，推倒也是在学"
          ]
        },
        {
          "text": "自己翻绘本",
          "stage": "f5",
          "materials": "厚纸板书",
          "steps": [
            "让他自己翻，跟着他的节奏",
            "他一直翻同一页就陪他看那一页",
            "不用按顺序读完"
          ]
        },
        {
          "text": "撕纸巾装碗里",
          "stage": "f5",
          "materials": "纸巾、一个碗",
          "steps": [
            "给他几张纸巾随便撕",
            "撕碎的往碗里装",
            "这个能玩很久，别中途打断"
          ]
        },
        {
          "text": "剥香蕉皮",
          "stage": "f5",
          "materials": "香蕉",
          "steps": [
            "先帮他把顶部掰开一点",
            "剩下的让他自己往下撕",
            "剥烂了照吃不误"
          ],
          "themes": [
            "fruit"
          ]
        },
        {
